# Local environment files (keep the documented template tracked).
.env
.env.*
!.env.example

# Credentials, private keys, and certificates.
secrets/
**/secrets/
*.secret
*.credentials
credentials.json
*_credentials.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Local database exports and backups.
*.sql.gz
*.dump
*.bak
backups/
**/backups/

# Terraform state and cache (keep .terraform.lock.hcl tracked).
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*.auto.tfvars

